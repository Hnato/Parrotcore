{
  "SchemaVersion": 2,
  "EngineVersion": "2.3.0",
  "ReleaseChannelUrl": "https://github.com/Hnato/Parrotcore/releases",
  "IsAdvancedMode": false,
  "LaunchAtStartup": false,
  "MinimizeToTrayOnClose": true,
  "CheckUpdatesOnStartup": true,
  "AutoStartServerOnLaunch": true,
  "Language": "en",
  "Theme": "light",
  "Port": 5000,
  "AutoFallbackPort": true,
  "BindMode": "both",
  "EnableHttps": false,
  "HttpsPort": 5010,
  "EnableCors": true,
  "CorsAllowedOrigins": "*",
  "EnableWebSockets": true,
  "EnableRequestLogging": true,
  "MaxRequestBodySizeMB": 100,
  "KeepAliveTimeoutSeconds": 120,
  "EnableDatabase": true,
  "IsConfigured": true,
  "DatabaseMode": "local_mariadb",
  "DatabaseProvider": "XAMPP",
  "DbHost": "127.0.0.1",
  "DbPort": 3306,
  "DbName": "",
  "DbUser": "root",
  "DbPassword": "",
  "SqliteFilePath": "Engine/Data/parrotcore.db",
  "MariaDbBinPath": "",
  "CustomConnectionString": "",
  "UseConnectionPooling": true,
  "ConnectionTimeoutSeconds": 15,
  "AutoGenerateSiteDbConfig": false,
  "ExposeRestDbApi": true,
  "WebsiteRootPath": "Web Site",
  "DefaultFiles": "index.php, index.html, index.htm, default.html",
  "EnablePhpInterpreter": true,
  "PhpExecutablePath": "",
  "EnableDirectoryBrowsing": false,
  "EnableSpaFallback": true,
  "SpaFallbackFile": "index.html",
  "EnableGzipCompression": true,
  "EnableStaticCache": false,
  "CacheMaxAgeSeconds": 3600,
  "EnableLiveReloadWatcher": true,
  "ServeUnknownMimeTypes": true,
  "Custom404Page": "404.html",
  "CustomHeaders": {
    "X-Frame-Options": "SAMEORIGIN"
  }
}